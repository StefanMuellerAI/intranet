# ---------------------------------------------------------------------------
# StefanAI Intranet — Umgebungsvariablen
# Kopie als .env.local anlegen und Werte eintragen.
# ---------------------------------------------------------------------------

# Basis-URL der App (Links in E-Mails und signierte Beleg-URLs)
# Produktion: https://intra.stefanai.de
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL (EU-Region Frankfurt wählen!)
# https://console.neon.tech → Connection String (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clerk (https://dashboard.clerk.com)
# Einstellungen im Clerk-Dashboard:
#  - E-Mail + Passwort als Anmeldeverfahren
#  - "Client Trust" / Device-Verifizierung per E-Mail-Code aktivieren
#  - Restrictions: Allowlist auf Domain stefanai.de
#  - Invitations aktivieren
#  - OAuth Applications: Dynamic Client Registration aktivieren
#    Default-Scopes: openid, profile, email (für Claude/Cursor MCP)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/anmelden

# Zulässige E-Mail-Domain (serverseitige Validierung, zusätzlich zur Clerk-Allowlist)
ALLOWED_EMAIL_DOMAIN=stefanai.de

# Brevo (transaktionale E-Mails) — ohne Key werden Mails nur geloggt (Dev)
BREVO_API_KEY=
MAIL_SENDER_EMAIL=intranet@stefanai.de
MAIL_SENDER_NAME=StefanAI Intranet

# Vercel Blob (Store-Region fra1 bei Erstellung wählen!)
BLOB_READ_WRITE_TOKEN=

# Secret für signierte, zeitlich begrenzte Beleg-Download-URLs (z. B. openssl rand -hex 32)
DOWNLOAD_URL_SECRET=

# AES-256-Schlüssel für Mitarbeiterdokumente (openssl rand -base64 32)
# ACHTUNG: Ohne diesen Schlüssel sind alle Dokumente unwiederbringlich verloren — sicher sichern!
DOCUMENT_ENCRYPTION_KEY=

# Secret für den Vercel-Cron-Endpunkt /api/cron/webhooks
CRON_SECRET=

# Seed: legt den Admin-User an (npm run db:seed)
ADMIN_EMAIL=stefan.mueller@stefanai.de
ADMIN_NAME=Stefan Müller
