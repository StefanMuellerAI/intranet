# Vorlage für .env.test — Werte eintragen und als .env.test speichern.
# .env.test wird nicht eingecheckt (siehe .gitignore).

# Neon-TEST-Branch (niemals die Produktions-/Dev-Datenbank!)
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Sicherheitsbestätigung: Die Test-Helfer leeren die Datenbank nur, wenn
# dieser Wert exakt "ja" ist. Verhindert versehentliche Läufe gegen Prod.
TEST_DB_RESET_ALLOWED=ja

# Clerk-DEVELOPMENT-Instanz (pk_test_/sk_test_ — niemals Live-Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/anmelden

# E2E-Test-User (werden im Global Setup automatisch in Clerk angelegt, falls
# nicht vorhanden; Login läuft ticketbasiert — kein Passwort nötig.
# E-Mail-Domain muss ALLOWED_EMAIL_DOMAIN entsprechen)
E2E_ADMIN_EMAIL=e2e-admin@stefanai.de
E2E_USER_EMAIL=e2e-mitarbeiter@stefanai.de

# App-Konfiguration für den Test-Server
ALLOWED_EMAIL_DOMAIN=stefanai.de
APP_BASE_URL=http://localhost:3100
DOWNLOAD_URL_SECRET=nur-fuer-tests-download-secret
CRON_SECRET=nur-fuer-tests-cron-secret
# Base64-kodierter 32-Byte-Schlüssel (openssl rand -base64 32). Nur Testwert —
# niemals in Produktion verwenden. Ver-/entschlüsselt Dokumente und Belege.
DOCUMENT_ENCRYPTION_KEY=c3RlZmFuYWktdGVzdC1kb2N1bWVudC1rZXktMzJieXQ=

# Optional: nur nötig für E2E-Tests mit echtem Beleg-Upload
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
